# ============================================================
# JobHunt – environment configuration
#
# SECURITY RULES
# • Never commit this file with real secrets.
# • All API keys are server-side only and are NEVER sent to
#   the browser.  The client only sends provider/model names.
# • Rotate any key that is accidentally exposed immediately.
# ============================================================

# ------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/db

# ------------------------------------------------------------
# AI provider keys  (add only the providers you intend to use)
#
# Supported providers and their available models are defined in
#   src/config/modelDefinitions.ts
# ------------------------------------------------------------

# OpenAI  →  models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4,
#            gpt-3.5-turbo, o1, o1-mini, o3-mini
OPENAI_API_KEY=
# Optional: override the default model used server-side
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL (leave blank to use the OpenAI default)
OPENAI_API_URL=
# Optional: OpenAI organisation ID
OPENAI_ORGANIZATION=

# Anthropic  →  models: claude-opus-4-5, claude-sonnet-4-5,
#               claude-3-5-sonnet-latest, claude-3-5-haiku-latest,
#               claude-3-opus-latest
ANTHROPIC_API_KEY=
# Optional: pin to a specific Anthropic API version (default: 2023-06-01)
ANTHROPIC_VERSION=

# Google Gemini  →  models: gemini-2.0-flash, gemini-2.0-flash-lite,
#                   gemini-1.5-pro, gemini-1.5-flash, gemini-1.5-flash-8b
GEMINI_API_KEY=

# OpenRouter (credentials and attribution are read server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional endpoint override and OpenRouter attribution headers
OPENROUTER_API_URL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=JobHunt

# Azure OpenAI  →  models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4,
#                  gpt-35-turbo, o1, o1-mini, o3-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Custom / self-hosted endpoint  →  model name is free-form
CUSTOM_LLM_API_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ------------------------------------------------------------
# Active provider (used server-side when BYOK is disabled)
# One of: openai | anthropic | gemini | azureOpenai | openrouter | custom
# ------------------------------------------------------------
LLM_PROVIDER=openai

# ------------------------------------------------------------
# Optional storage / remote config integrations
# ------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
EDGE_CONFIG=

# ------------------------------------------------------------
# Feature flag fallbacks (used when EDGE_CONFIG is unavailable)
# ------------------------------------------------------------
FEATURE_ENABLE_COMPANY_INSIGHTS=true
FEATURE_ENABLE_BYOK=false
FEATURE_STORE_EXPORTS_IN_BLOB=true

# ------------------------------------------------------------
# Web insights provider
# ------------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
