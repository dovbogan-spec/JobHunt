# Required
OPENAI_API_KEY=
DATABASE_URL=postgres://user:password@host:5432/db

# Optional model override
OPENAI_MODEL=gpt-5.2

# Optional storage/config integrations
BLOB_READ_WRITE_TOKEN=
EDGE_CONFIG=

# Optional feature flag fallbacks (used when EDGE_CONFIG is unavailable)
FEATURE_ENABLE_COMPANY_INSIGHTS=true
FEATURE_ENABLE_BYOK=false
FEATURE_STORE_EXPORTS_IN_BLOB=true

# Optional web insights provider config
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
