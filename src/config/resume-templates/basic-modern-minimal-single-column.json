{
  "template_id": "basic_modern_minimal_single_column",
  "meta": {
    "name": "Basic Modern Minimal (Single Column)",
    "version": "1.0.0",
    "description": "Baseline single-column resume layout focused on clarity and ATS compatibility."
  },
  "style": {
    "tone": "clean_professional",
    "density": "medium",
    "spacing": {
      "section_gap": "medium",
      "bullet_gap": "tight",
      "line_height": "1.15-1.25"
    },
    "typography": {
      "font_family": "Sans (e.g., Inter/Calibri/Helvetica)",
      "name_size": "20-24",
      "title_size": "12-14",
      "section_heading_size": "12-13",
      "body_size": "10-11",
      "emphasis": {
        "section_headings": "bold",
        "company_and_role": "bold (company), regular (role)"
      }
    },
    "alignment": {
      "main": "left",
      "dates": "right_inline"
    },
    "bullets": {
      "style": "•",
      "max_per_role": "4-7",
      "start_with_action_verbs": true,
      "include_metrics_when_possible": true
    }
  },
  "header_block": {
    "lines": [
      { "line_1": "{FULL_NAME}" },
      { "line_2": "{PRIMARY_TITLE} – {SPECIALIZATION_1} & {SPECIALIZATION_2}" },
      { "line_3": "{EMAIL}  {PHONE}  {LINKEDIN}  {PORTFOLIO_OR_GITHUB(optional)}" }
    ],
    "rules": [
      "keep_header_to_3_lines",
      "make_title_line_scannable",
      "links_inline_separated_by_spaces"
    ]
  },
  "body_flow_order": [
    "Profile",
    "Professional_Experience",
    "Education",
    "Skills",
    "Interests",
    "Languages"
  ],
  "footer": {
    "show_page_x_of_y": true,
    "show_name_in_footer": true
  },
  "schema": {
    "header": {
      "full_name": "",
      "headline": {
        "primary_title": "",
        "specializations": ["", ""]
      },
      "contact": {
        "email": "",
        "phone": "",
        "linkedin": "",
        "portfolio": ""
      }
    },
    "sections": [
      {
        "id": "profile",
        "title": "Profile",
        "type": "paragraph",
        "fields": {
          "summary_2to4_lines": "",
          "positioning_keywords": ["", "", ""]
        }
      },
      {
        "id": "experience",
        "title": "Professional Experience",
        "type": "list",
        "item_template": "experience_item",
        "fields": {
          "items": []
        }
      },
      {
        "id": "education",
        "title": "Education",
        "type": "list",
        "item_template": "education_item",
        "fields": {
          "items": []
        }
      },
      {
        "id": "skills",
        "title": "Skills",
        "type": "grouped_bullets",
        "item_template": "skill_group",
        "fields": {
          "groups": []
        }
      },
      {
        "id": "interests",
        "title": "Interests",
        "type": "inline_list",
        "fields": {
          "items": ["", "", ""]
        }
      },
      {
        "id": "languages",
        "title": "Languages",
        "type": "list",
        "item_template": "language_item",
        "fields": {
          "items": []
        }
      }
    ]
  },
  "components": {
    "experience_item": {
      "row_1": {
        "left": "{COMPANY}",
        "right": "{START_MMYYYY} – {END_MMYYYY_or_Present}",
        "styles": {
          "company": "bold",
          "dates": "regular"
        }
      },
      "row_2": {
        "left": "{ROLE_TITLE}",
        "right": "",
        "styles": {
          "role": "regular"
        }
      },
      "bullets": [
        "{ACTION + SCOPE + IMPACT + METRIC}",
        "{ACTION + SYSTEM/ARCH + OUTCOME}",
        "{ACTION + CROSS_FUNCTIONAL + RESULT}",
        "{ACTION + REUSABLE_PATTERN + SCALE}"
      ],
      "rules": {
        "allow_multiple_roles_under_same_company": true,
        "if_multiple_roles": [
          "show_role_title_as_subheading",
          "keep_company_once_at_top"
        ],
        "keep_each_bullet_1_line_when_possible": true,
        "prefer_numbers": true
      }
    },
    "education_item": {
      "primary_line": "{DEGREE}, {FIELD}, {INSTITUTION}",
      "secondary_line_optional": "Final Project: {ONE_LINE_PROJECT_SUMMARY}",
      "rules": [
        "keep_education_compact",
        "emphasize_project_if_relevant_to_target_role"
      ]
    },
    "skill_group": {
      "category_title": "{CATEGORY_NAME}",
      "bullets": [
        "{CAPABILITY_1}",
        "{CAPABILITY_2}",
        "{CAPABILITY_3}",
        "{TOOLS_AND_PLATFORMS}"
      ],
      "rules": [
        "3_to_6_bullets_per_group",
        "mix_concepts_and_tools",
        "keep_each_bullet_high_signal"
      ]
    },
    "language_item": {
      "language": "{LANGUAGE_NAME}",
      "proficiency": "{Native/Bilingual|Fluent|Professional|Conversational|Basic}",
      "render": "{language} — {proficiency}"
    }
  },
  "tailoring_controls": {
    "section_visibility": {
      "profile": true,
      "interests": true,
      "languages": true,
      "education": true
    },
    "reorder_sections": {
      "allowed": true,
      "common_variants": [
        ["Profile", "Skills", "Professional Experience", "Education", "Languages"],
        ["Profile", "Professional Experience", "Skills", "Education"]
      ]
    },
    "experience_bullet_style": {
      "metrics_required": true,
      "max_bullets_per_role": 6
    },
    "headline_variants": [
      "{ROLE_TARGET} – {DOMAIN_1} & {DOMAIN_2}",
      "{ROLE_TARGET} | {TOP_STRENGTH_1} | {TOP_STRENGTH_2}"
    ]
  }
}
